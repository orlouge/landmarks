{
  "type": "landmarks:noise",
  "config": {
    "debug": false,
    "variants": {
      "size": [
        { "variant_name": "ocean_rocks_deep", "biome": "#landmarks:has_ocean_rocks_deep", "weight": 5 },
        { "variant_name": "ocean_rocks_shallow", "biome": "#landmarks:has_ocean_rocks_shallow", "weight": 5 },
        { "variant_name": "huge", "weight": 0.005 },
