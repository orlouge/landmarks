      "min_radius": [
        10,
        { "value": 48, "has_variants": {"size": ["huge", "ocean_rocks_shallow", "ocean_rocks_deep"]}, "weight": 100}
      ],
      "min_height": [
        3, 5, 5, 5,
        { "value": 16, "has_variants": {"size": "ocean_rocks_shallow"}, "weight": 1e7},
        { "value": 34, "has_variants": {"size": "ocean_rocks_deep"}, "weight": 1e7}
      ],
      "max_height": [
        5, 5, 5, 5, 7, 7, 7, 7, 10, 10, 10, 10, 10, 15, 30,
        { "value": 40, "has_variants": {"size": "ocean_rocks_shallow"}, "weight": 50},
        { "value": 60, "has_variants": {"size": "ocean_rocks_deep"}, "weight": 50},
        { "value": 80, "has_variants": {"size": "huge"}, "weight": 100},
        { "value": 250, "has_variants": {"size": "huge"}, "weight": 10}
      ],
      "radius": {
        "type": "landmarks:feature_random_number",
        "seed": "radius",
        "min": { "type": "landmarks:feature_user_parameter", "parameter": "min_radius" },
        "max": "landmarks:feature_radius",
        "mean": 20,
        "std": 9
      },
      "negated_radius": {
        "type": "landmarks:negate",
        "argument": { "type": "landmarks:feature_user_parameter", "parameter": "radius" }
      },
      "water_above_surface": {
        "type": "landmarks:map",
        "y": { "type": "add", "argument1": "landmarks:feature_surface_y", "argument2": 1},
        "input": {
          "type": "landmarks:feature_block_matches",
          "matches": ["minecraft:water"]
        }
      }
    },
    "min_y": {
      "type": "minecraft:add",
      "argument1": { "type": "landmarks:feature_origin_y" },
      "argument2": -4
    },
    "max_y": {
      "type": "minecraft:add",
      "argument1": { "type": "landmarks:feature_origin_y" },
      "argument2": {
        "type": "landmarks:feature_random_number",
        "seed": "height",
        "min": { "type": "landmarks:feature_user_parameter", "parameter": "min_height" },
        "max": { "type": "landmarks:feature_user_parameter", "parameter": "max_height" }
      }
    },
    "min_x": {
      "type": "minecraft:add",
      "argument1": "landmarks:feature_center_x",
      "argument2": { "type": "landmarks:feature_user_parameter", "parameter": "negated_radius" }
