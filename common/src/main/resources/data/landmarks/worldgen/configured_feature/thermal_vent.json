        "type": "landmarks:feature_cache",
        "argument": {
          "type": "landmarks:feature_block_matches",
          "matches": ["#landmarks:rocks_replace"]
        }
      },
      "free_space_below": {
        "type": "landmarks:feature_cache",
        "argument": {
          "type": "landmarks:feature_block_matches",
          "matches": ["#minecraft:azalea_root_replaceable"]
        }
      }
    },
    "min_x": { "type": "landmarks:feature_min_x" },
    "min_z": { "type": "landmarks:feature_min_z" },
    "max_z": { "type": "landmarks:feature_max_z" },
    "max_x": { "type": "landmarks:feature_max_x" },
    "min_y": { "type": "add", "argument1": "landmarks:feature_surface_y", "argument2": -4 },
    "max_y": {
      "type": "add",
      "argument1": "landmarks:feature_surface_y",
      "argument2": {
        "type": "landmarks:feature_random_number",
        "seed": "radius",
        "min": 5,
        "max": 15,
        "mean": 5,
        "std": 3
      }
    },
    "generators": [
      "landmarks:thermal_vent"
    ]
