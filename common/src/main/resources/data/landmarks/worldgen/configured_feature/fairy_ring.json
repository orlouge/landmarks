{
  "type": "landmarks:noise",
  "config": {
    "debug": false,
    "parameters": {
      "free_space_above": {
        "type": "landmarks:feature_cache",
        "argument": {
          "type": "landmarks:feature_block_matches",
          "matches": ["#landmarks:rocks_replace"]
        }
      },
      "free_space_below": {
        "type": "landmarks:feature_cache",
        "argument": {
          "type": "landmarks:feature_block_matches",
          "matches": ["#minecraft:dirt"]
        }
      }
    },
    "bounds": {
      "type": "landmarks:max_density_square",
      "min_x": { "type": "landmarks:feature_min_x" },
      "min_y": "landmarks:feature_surface_y",
      "min_z": { "type": "landmarks:feature_min_z" },
      "max_x": { "type": "landmarks:feature_max_x" },
      "max_y": "landmarks:feature_surface_y",
      "max_z": { "type": "landmarks:feature_max_z" },
      "argument": {
        "type": "minecraft:min",
        "argument2": {
          "type": "landmarks:min_along_y",
          "argument": { "type": "landmarks:feature_user_parameter", "parameter": "free_space_above" },
          "min_y": { "type": "landmarks:feature_origin_y" },
          "max_y": { "type": "add", "argument1": 4, "argument2": { "type": "landmarks:feature_origin_y" } }
        },
        "argument1": {
          "type": "landmarks:min_along_y",
          "argument": { "type": "landmarks:feature_user_parameter", "parameter": "free_space_below" },
          "min_y": "landmarks:feature_surface_y",
          "max_y": "landmarks:feature_surface_y"
        }
      },
      "min_side": 6,
      "max_side": {
        "type": "landmarks:feature_random_number",
        "seed": "radius",
        "min": 6,
        "max": 20,
        "mean": 6,
        "std": 4
      }
    },
    "min_y": "landmarks:feature_surface_y",
    "max_y": { "type": "landmarks:feature_origin_y" },
    "generators": [
      "landmarks:fairy_ring"
    ]
  }
}